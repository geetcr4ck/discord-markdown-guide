---
import {
  cheatGroups,
  cheatRows,
  cheatTotal,
  type CheatGroupId,
} from "../content/cheatsheet";
import type { Lang } from "../i18n/routes";
import { t, type UIKey } from "../i18n/ui";
import { toHTML } from "../markdown";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const translate = t(lang);

const groupLabelKeys = {
  text: "cheat.group.text",
  blocks: "cheat.group.blocks",
  people: "cheat.group.people",
  more: "cheat.group.more",
} satisfies Record<CheatGroupId, UIKey>;

const preparedGroups = cheatGroups.map((group) => ({
  ...group,
  rows: cheatRows
    .filter((row) => row.group === group.id)
    .map((row) => {
      const discordCallback = Object.entries(row.discord ?? {}).reduce<
        Record<string, () => string>
      >((callbacks, [name, value]) => {
        callbacks[name] = () => value;
        return callbacks;
      }, {});

      const html = toHTML(row.render?.[lang] ?? row.syntax[lang], {
        discordCallback,
        locale: lang,
      });

      return {
        ...row,
        labelText: row.label[lang],
        searchText: row.keywords.replace(/[<>]/g, " "),
        syntaxText: row.syntax[lang],
        href: `/${lang}/${row.slug}#${row.anchor[lang]}`,
        copyable: row.copy !== false,
        html,
      };
    }),
}));

const copyLabel = translate("cheat.copy");
const youType = translate("cheat.youType");
const discordShows = translate("cheat.discordShows");
---

<section
  class="cheat"
  data-cheat
  data-cheat-total={cheatTotal}
  aria-label={translate("home.kicker")}
>
  <div class="cheat-toolbar" data-cheat-toolbar>
    <div class="cheat-search">
      <label class="cheat-search-label" for="cheat-search" id="cheat-search-label">
        {translate("cheat.search")}
      </label>
      <div class="cheat-search-field">
        <svg
          class="cheat-search-icon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <circle cx="10.75" cy="10.75" r="6.25"></circle>
          <path d="m15.5 15.5 4.25 4.25"></path>
        </svg>
        <input
          class="cheat-search-input"
          id="cheat-search"
          type="search"
          data-cheat-input
          aria-labelledby="cheat-search-label"
          placeholder={translate("cheat.placeholder")}
          autocomplete="off"
          spellcheck="false"
        />
        <button class="cheat-clear" type="button" data-cheat-clear hidden>
          {translate("cheat.clear")}
        </button>
      </div>
    </div>

    <p class="cheat-count">
      <span class="visually-hidden">{translate("cheat.countLabel")}:</span>
      <span data-cheat-count>{cheatTotal} / {cheatTotal}</span>
    </p>
  </div>

  {preparedGroups.map((group, groupIndex) => (
    <section
      class="cheat-group"
      data-cheat-group={group.id}
      aria-labelledby={`cheat-group-${group.id}`}
    >
      <div class="cheat-group-head">
        <span class="cheat-group-no" aria-hidden="true">
          {String(groupIndex + 1).padStart(2, "0")}
        </span>
        <h2 id={`cheat-group-${group.id}`}>
          {translate(groupLabelKeys[group.id])}
        </h2>
      </div>

      <div class="cheat-columns" aria-hidden="true">
        <span></span>
        <span>{youType}</span>
        <span>{discordShows}</span>
      </div>

      <dl class="cheat-list">
        {group.rows.map((row) => (
          <div
            class="cheat-row"
            data-cheat-row
            data-copy-scope
            data-group={row.group}
            data-keywords={row.searchText}
            data-copy={row.copyable ? "true" : "false"}
          >
            <dt class="cheat-term">
              <a class="cheat-link" href={row.href}>
                {row.labelText}
              </a>
            </dt>

            <dd class="cheat-syntax-cell">
              <span class="cheat-cell-label">{youType}</span>
              <pre class="cheat-syntax"><code data-copy-target>{row.syntaxText}</code></pre>
              {row.copyable && (
                <button
                  class="copy-button"
                  type="button"
                  data-copy
                  data-copy-label={row.labelText}
                  aria-label={`${copyLabel}: ${row.labelText}`}
                >
                  <span data-copy-label-visual aria-hidden="true">
                    {copyLabel}
                  </span>
                </button>
              )}
            </dd>

            <dd class="cheat-result specimen-pane">
              <span class="cheat-cell-label">{discordShows}</span>
              <div class="cheat-result-body" set:html={row.html}></div>
            </dd>
          </div>
        ))}
      </dl>
    </section>
  ))}

  <div class="cheat-empty" data-cheat-empty role="status" hidden>
    <p>{translate("cheat.empty")}</p>
    <button class="cheat-reset" type="button" data-cheat-reset>
      {translate("cheat.reset")}
    </button>
  </div>
</section>

<script>
  import { initCheat } from "../scripts/cheat";

  initCheat();
</script>

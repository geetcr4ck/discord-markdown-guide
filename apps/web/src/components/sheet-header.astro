---
import type { Lang } from '../i18n/routes';
import { home, play, switchLocale } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  currentLocale: Lang;
}

const { currentLocale } = Astro.props;
const translate = t(currentLocale);
const currentPath = Astro.url.pathname;
const homeUrl = home(currentLocale);
const playUrl = play(currentLocale);
const enUrl = switchLocale(currentPath, 'en');
const idUrl = switchLocale(currentPath, 'id');
---

<header class="sticky top-0 z-40 w-full h-14 bg-[var(--paper)] border-b border-[var(--rule)] flex items-center justify-center px-2 sm:px-4">
  <nav aria-label={translate('nav.primary')} class="header-capsule flex items-center gap-1 sm:gap-4 px-2 sm:px-4 py-2 bg-[var(--paper)] border border-[var(--rule)] rounded-[999px] text-sm shadow-sm">
    <a
      href={homeUrl}
      class="brand-link"
      aria-label={translate('site.name')}
    >
      <img
        src="/logo-96.png"
        alt=""
        width="24"
        height="24"
        decoding="async"
        class="brand-mark"
      />
      <span class="brand-text">{translate('brand.short')}</span>
    </a>

    <div class="header-nav-cluster flex items-center gap-1 sm:gap-5">
      <div class="h-3 w-px bg-[var(--rule)]" aria-hidden="true"></div>

      <div class="flex items-center gap-1 sm:gap-5">
        <a
          href={homeUrl}
          aria-current={currentPath === homeUrl ? 'page' : undefined}
          class={`nav-link whitespace-nowrap hover:text-[var(--blue)] transition-colors ${currentPath === homeUrl ? 'text-[var(--blue)] font-medium' : 'text-[var(--ink2)]'}`}
        >
          {translate('nav.cheatsheet')}
        </a>

        <a
          href={playUrl}
          aria-current={currentPath === playUrl ? 'page' : undefined}
          class={`hidden sm:inline-block whitespace-nowrap hover:text-[var(--blue)] transition-colors ${currentPath === playUrl ? 'text-[var(--blue)] font-medium' : 'text-[var(--ink2)]'}`}
        >
          {translate('nav.playground')}
        </a>
      </div>
    </div>

    <button
      type="button"
      data-theme-toggle
      aria-label={translate('theme.toDark')}
      class="theme-toggle"
    >
      <svg
        data-theme-icon="moon"
        class="theme-icon"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5 8.5 8.5 0 1 0 20.5 14.5Z"></path>
      </svg>
      <svg
        data-theme-icon="sun"
        class="theme-icon"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
      </svg>
    </button>

    <div class="h-3 w-px bg-[var(--rule)]" aria-hidden="true"></div>

    <div role="group" class="flex items-center gap-0.5 sm:gap-1 font-mono text-xs" aria-label={translate('nav.language')}>
      <a
        href={enUrl}
        lang="en"
        class={`whitespace-nowrap px-0.5 sm:px-1 py-0.5 transition-colors ${currentLocale === 'en' ? 'text-[var(--ink)] font-semibold border-b border-[var(--ink)]' : 'text-[var(--ink3)] hover:text-[var(--ink)]'}`}
        aria-current={currentLocale === 'en' ? 'true' : undefined}
      >
        EN
      </a>
      <span class="text-[var(--rule)]" aria-hidden="true">·</span>
      <a
        href={idUrl}
        lang="id"
        class={`whitespace-nowrap px-0.5 sm:px-1 py-0.5 transition-colors ${currentLocale === 'id' ? 'text-[var(--ink)] font-semibold border-b border-[var(--ink)]' : 'text-[var(--ink3)] hover:text-[var(--ink)]'}`}
        aria-current={currentLocale === 'id' ? 'true' : undefined}
      >
        ID
      </a>
    </div>
  </nav>
</header>

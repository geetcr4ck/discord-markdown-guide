---
// Root redirect to /en
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0;url=/en" />
    <link rel="canonical" href="https://discord-markdown-guide.pages.dev/en" />
    <meta name="robots" content="noindex" />
    <title>Redirecting to /en...</title>
    <style>
      :root {
        color-scheme: light;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background-color: #F2EFE7;
        color: #16171B;
        font-family: "IBM Plex Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      body {
        padding: 40px;
        text-align: center;
      }

      a {
        color: #1F4FD8;
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          color-scheme: dark;
        }

        html,
        body {
          background-color: #1A1A1A;
          color: #E8E8E8;
        }

        a {
          color: #6EA8FE;
        }
      }
    </style>
  </head>
  <body>
    <p>Redirecting to <a href="/en">Discord Markdown Guide</a>...</p>
  </body>
</html>
